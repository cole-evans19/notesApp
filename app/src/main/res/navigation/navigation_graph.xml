<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.notesapp.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/navigateToNotes"
            app:destination="@+id/noteListFragment"/>
    </fragment>

    <fragment
        android:id="@+id/noteListFragment"
        android:name="com.example.notesapp.NoteListFragment"
        android:label="NoteListFragment"
        tools:layout="@layout/fragment_note_list">
        <action
            android:id="@+id/show_note_detail"
            app:destination="@id/noteDetailFragment" />
        <action
            android:id="@+id/action_noteListFragment_to_deleteNoteFragment"
            app:destination="@id/deleteNoteFragment" />
    </fragment>

    <fragment
        android:id="@+id/noteDetailFragment"
        android:name="com.example.notesapp.NoteDetailFragment"
        android:label="Note"
        tools:layout="@layout/fragment_note_detail">
        <argument
            android:name="noteId"
            app:argType="java.util.UUID"
            app:nullable="true" />
    </fragment>
    <dialog
        android:id="@+id/deleteNoteFragment"
        android:name="com.example.notesapp.DeleteNoteFragment"
        android:label="DeleteNoteFragment" >
        <argument
            android:name="deleteTicket"
            app:argType="boolean"/>
    </dialog>

</navigation>